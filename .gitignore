# Monorepo Root .gitignore

# Dependencies
/node_modules/
/backend/vendor/
/frontend/node_modules/

# Environment and Secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa
id_ed25519

# Build outputs
/frontend/dist/
/frontend/dist-ssr/
*.tsbuildinfo

# Laravel specific
/backend/public/hot
/backend/public/storage
/backend/storage/*.key
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/testing/*
/backend/storage/framework/views/*
/backend/storage/logs/*
!/backend/storage/logs/.gitignore
!/backend/storage/framework/cache/.gitignore
!/backend/storage/framework/sessions/.gitignore
!/backend/storage/framework/testing/.gitignore
!/backend/storage/framework/views/.gitignore

# Testing and Coverage
.phpunit.cache/
.phpunit.result.cache
coverage/
*.lcov

# IDEs and OS
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Database dumps / backups
*.sql
*.sql.gz
*.dump
dump.rdb
